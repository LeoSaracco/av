# ── AV Fitness App — Environment Variables ───────────────────────────────────
# Copiar a .env y ajustar valores

# ============================================
# Frontend (Vite)
# ============================================
# Local:  http://localhost:8080/api
# Prod:   https://av-fitness-backend.railway.app/api
VITE_API_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:8080/ws

# ============================================
# Backend (Spring Boot)
# ============================================
# Perfil: local | production
SPRING_PROFILES_ACTIVE=local

# JWT (256-bit mínimo, generar con: openssl rand -base64 32)
JWT_SECRET=dev-secret-change-me-in-production

# MercadoPago
MP_ACCESS_TOKEN=TEST-00000000
MP_WEBHOOK_SECRET=test

# Resend (email)
RESEND_API_KEY=re_test_00000000
RESEND_FROM=av@avfitness.app

# CORS origins (separados por coma)
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (local docker)
DATABASE_URL=jdbc:postgresql://localhost:5432/av_fitness
