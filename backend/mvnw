#!/bin/sh
# ── Maven Wrapper Startup Script ─────────────────────────────────────────────
# Descarga y ejecuta el Maven Wrapper para evitar requerir Maven instalado
# Uso: ./mvnw [args]

# find Java
if [ -n "$JAVA_HOME" ] ; then
  JAVACMD="$JAVA_HOME/bin/java"
else
  JAVACMD="java"
fi

# Maven wrapper properties
MAVEN_OPTS="${MAVEN_OPTS} -Xmx1024m"
WRAPPER_JAR=".mvn/wrapper/maven-wrapper.jar"

# download wrapper jar if missing
if [ ! -f "$WRAPPER_JAR" ]; then
  echo "Descargando Maven Wrapper..."
  WRAPPER_URL=$(grep wrapperUrl .mvn/wrapper/maven-wrapper.properties | cut -d= -f2)
  curl -sL "$WRAPPER_URL" -o "$WRAPPER_JAR" || wget -q "$WRAPPER_URL" -O "$WRAPPER_JAR"
fi

exec "$JAVACMD" $MAVEN_OPTS -jar "$WRAPPER_JAR" "$@"
